# =========================
# 基本配置
# =========================
TARGET := target_output
SRC_DIR := src
INC_DIR := include
OUT_DIR := output

X86_CC := gcc
ARM_CC := aarch64-buildroot-linux-gnu-gcc

COMMON_CFLAGS := -Wall -Wextra -I$(INC_DIR)
DEBUG_CFLAGS := -g -O0
RELEASE_CFLAGS := -O2 -DNDEBUG

COMMON_LDFLAGS :=
DEBUG_LDFLAGS :=
RELEASE_LDFLAGS :=

# 自动查找 src 目录下所有 .c 文件
SRCS := $(wildcard $(SRC_DIR)/*.c)

# =========================
# 默认目标
# =========================
.PHONY: all \
        x86_debug x86_release arm_debug arm_release \
        clean clean_x86 clean_arm

all: x86_debug x86_release arm_debug arm_release

# =========================
# x86 debug
# =========================
X86_DEBUG_OUT_DIR := $(OUT_DIR)/x86/debug
X86_DEBUG_OBJS := $(patsubst $(SRC_DIR)/%.c,$(X86_DEBUG_OUT_DIR)/%.o,$(SRCS))
X86_DEBUG_TARGET := $(X86_DEBUG_OUT_DIR)/$(TARGET)

x86_debug: $(X86_DEBUG_TARGET)

$(X86_DEBUG_TARGET): $(X86_DEBUG_OBJS)
	$(X86_CC) $(X86_DEBUG_OBJS) -o $@ $(COMMON_LDFLAGS) $(DEBUG_LDFLAGS)

$(X86_DEBUG_OUT_DIR)/%.o: $(SRC_DIR)/%.c | $(X86_DEBUG_OUT_DIR)
	$(X86_CC) $(COMMON_CFLAGS) $(DEBUG_CFLAGS) -c $< -o $@

$(X86_DEBUG_OUT_DIR):
	mkdir -p $(X86_DEBUG_OUT_DIR)

# =========================
# x86 release
# =========================
X86_RELEASE_OUT_DIR := $(OUT_DIR)/x86/release
X86_RELEASE_OBJS := $(patsubst $(SRC_DIR)/%.c,$(X86_RELEASE_OUT_DIR)/%.o,$(SRCS))
X86_RELEASE_TARGET := $(X86_RELEASE_OUT_DIR)/$(TARGET)

x86_release: $(X86_RELEASE_TARGET)

$(X86_RELEASE_TARGET): $(X86_RELEASE_OBJS)
	$(X86_CC) $(X86_RELEASE_OBJS) -o $@ $(COMMON_LDFLAGS) $(RELEASE_LDFLAGS)

$(X86_RELEASE_OUT_DIR)/%.o: $(SRC_DIR)/%.c | $(X86_RELEASE_OUT_DIR)
	$(X86_CC) $(COMMON_CFLAGS) $(RELEASE_CFLAGS) -c $< -o $@

$(X86_RELEASE_OUT_DIR):
	mkdir -p $(X86_RELEASE_OUT_DIR)

# =========================
# arm debug
# =========================
ARM_DEBUG_OUT_DIR := $(OUT_DIR)/arm/debug
ARM_DEBUG_OBJS := $(patsubst $(SRC_DIR)/%.c,$(ARM_DEBUG_OUT_DIR)/%.o,$(SRCS))
ARM_DEBUG_TARGET := $(ARM_DEBUG_OUT_DIR)/$(TARGET)

arm_debug: $(ARM_DEBUG_TARGET)

$(ARM_DEBUG_TARGET): $(ARM_DEBUG_OBJS)
	$(ARM_CC) $(ARM_DEBUG_OBJS) -o $@ $(COMMON_LDFLAGS) $(DEBUG_LDFLAGS)

$(ARM_DEBUG_OUT_DIR)/%.o: $(SRC_DIR)/%.c | $(ARM_DEBUG_OUT_DIR)
	$(ARM_CC) $(COMMON_CFLAGS) $(DEBUG_CFLAGS) -c $< -o $@

$(ARM_DEBUG_OUT_DIR):
	mkdir -p $(ARM_DEBUG_OUT_DIR)

# =========================
# arm release
# =========================
ARM_RELEASE_OUT_DIR := $(OUT_DIR)/arm/release
ARM_RELEASE_OBJS := $(patsubst $(SRC_DIR)/%.c,$(ARM_RELEASE_OUT_DIR)/%.o,$(SRCS))
ARM_RELEASE_TARGET := $(ARM_RELEASE_OUT_DIR)/$(TARGET)

arm_release: $(ARM_RELEASE_TARGET)

$(ARM_RELEASE_TARGET): $(ARM_RELEASE_OBJS)
	$(ARM_CC) $(ARM_RELEASE_OBJS) -o $@ $(COMMON_LDFLAGS) $(RELEASE_LDFLAGS)

$(ARM_RELEASE_OUT_DIR)/%.o: $(SRC_DIR)/%.c | $(ARM_RELEASE_OUT_DIR)
	$(ARM_CC) $(COMMON_CFLAGS) $(RELEASE_CFLAGS) -c $< -o $@

$(ARM_RELEASE_OUT_DIR):
	mkdir -p $(ARM_RELEASE_OUT_DIR)

# =========================
# 清理
# =========================
clean:
	rm -rf $(OUT_DIR)

clean_x86:
	rm -rf $(OUT_DIR)/x86

clean_arm:
	rm -rf $(OUT_DIR)/arm

